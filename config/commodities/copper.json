{
  "schema_version": "commodity-adapter.v1",
  "adapter_id": "copper",
  "display_name": "铜产业链",
  "aliases": ["铜", "沪铜", "copper"],
  "exchanges": ["SHFE", "INE"],
  "variety_ids": ["CU", "BC"],
  "commodity_category": "non_ferrous",
  "quote_unit": "CNY/ton",
  "trading_unit": "ton",
  "spot_benchmarks": [
    {
      "benchmark_id": "shanghai_copper_spot",
