  "scenario_method": {
    "method": "supply_demand_cost_and_inventory_ranges",
    "required_drivers": ["demand", "mine_supply", "smelter_utilization", "inventory", "spot_cost"],
    "invalidators": ["demand_collapse", "unexpected_supply_release", "benchmark_incomparability"],
    "range_policy": "observation_range_not_intrinsic_value"
  },
  "acceptance_samples": [
    {
      "sample_id": "copper-contract-ready",
